        <briefdescription>
<para>Concatenates two viewable ranges into a <computeroutput><ref refid="classgl_1_1util_1_1concat__view" kindref="compound">concat_view</ref></computeroutput>. </para>
        </briefdescription>
        <detaileddescription>
<sect3 id="group__GL-Util_1example-usage-23">
<title>Example usage</title>
<para><programlisting filename=".cpp"><codeline><highlight class="normal">std::vector&lt;int&gt;<sp/><ref refid="group__GL-Core_1gaaae078e2ee09bb6b088baac9cb8f23c9" kindref="member">v1</ref><sp/>=<sp/>{1,<sp/>2,<sp/>3};</highlight></codeline>
<codeline><highlight class="normal">std::vector&lt;int&gt;<sp/><ref refid="group__GL-Core_1gaaae078e2ee09bb6b088baac9cb8f23c9" kindref="member">v2</ref><sp/>=<sp/>{4,<sp/>5,<sp/>6};</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">auto</highlight><highlight class="normal"><sp/><ref refid="group__GL-Core_1gaaae078e2ee09bb6b088baac9cb8f23c9" kindref="member">concatenated</ref><sp/>=<sp/><ref refid="group__GL-Util_1gab0f9de06fb9591214af73942a4c37929" kindref="member">gl::util::concat</ref>(<ref refid="group__GL-Core_1gaaae078e2ee09bb6b088baac9cb8f23c9" kindref="member">v1</ref>,<sp/><ref refid="group__GL-Core_1gaaae078e2ee09bb6b088baac9cb8f23c9" kindref="member">v2</ref>);</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordflow">for</highlight><highlight class="normal"><sp/>(</highlight><highlight class="keywordtype">int</highlight><highlight class="normal"><sp/><ref refid="group__GL-Core_1gaaae078e2ee09bb6b088baac9cb8f23c9" kindref="member">x</ref><sp/>:<sp/><ref refid="group__GL-Core_1gaaae078e2ee09bb6b088baac9cb8f23c9" kindref="member">concatenated</ref>)</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>std::<ref refid="group__GL-Core_1gaaae078e2ee09bb6b088baac9cb8f23c9" kindref="member">cout</ref><sp/>&lt;&lt;<sp/><ref refid="group__GL-Core_1gaaae078e2ee09bb6b088baac9cb8f23c9" kindref="member">x</ref><sp/>&lt;&lt;<sp/></highlight><highlight class="stringliteral">&quot;<sp/>&quot;</highlight><highlight class="normal">;<sp/></highlight><highlight class="comment">//<sp/>Output:<sp/>1<sp/>2<sp/>3<sp/>4<sp/>5<sp/>6</highlight></codeline>
</programlisting></para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>r1</parametername>
</parameternamelist>
<parameterdescription>
<para>First range to concatenate. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>r2</parametername>
</parameternamelist>
<parameterdescription>
<para>Second range to concatenate. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
